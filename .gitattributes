# تنظیمات کلی: تمام فایل‌های متنی را به LF (یونیکسی) تبدیل کن
* text=auto eol=lf

# فایل‌های پایتون و وب حتماً با LF ذخیره شوند
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# فایل‌های ضروری جنگو
*.env text eol=lf
requirements.txt text eol=lf

# فایل‌های باینری (تصاویر، فونت‌ها و...) را دست نزن تا خراب نشوند
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary
*.gz binary